# Copy to .env.local and fill in. Never commit .env.local.

# --- Sanity (public, safe to expose: used to fetch public catalog data) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Optional: your Stripe shipping rate ID. If unset, the original
# hardcoded rate is used as a fallback.
# STRIPE_SHIPPING_RATE_ID=

# Optional: public base URL of the deployed site (e.g. https://your-store.vercel.app).
# Used for Stripe success/cancel redirects instead of trusting request headers.
# NEXT_PUBLIC_BASE_URL=

# Webhook signing secret (Stripe Dashboard -> Developers -> Webhooks,
# or `stripe listen --forward-to localhost:3000/api/stripe-webhook` locally).
# Subscribe to: checkout.session.completed,
# checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=

# Optional, SERVER-ONLY: read token, only needed if your Sanity dataset is
# private. No NEXT_PUBLIC_ prefix = never sent to the browser.
# SANITY_API_TOKEN=

# Server-only WRITE token for order persistence from the Stripe webhook
# (Sanity Manage -> API -> Tokens, Editor/Admin). Falls back to
# SANITY_API_TOKEN if unset.
SANITY_API_WRITE_TOKEN=

# DEPRECATED: NEXT_PUBLIC_SANITY_TOKEN is no longer read by the app.
# It was previously shipped to every browser. If it had write access,
# rotate/revoke it in Sanity Manage -> API -> Tokens.
